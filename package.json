{
  "name": "pixel-annotator",
  "version": "1.1.0",
  "description": "PixelAnnotator (PxA) — anote elementos da página e exporte feedback para o Claude Code",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:e2e": "wxt build --mode e2e",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "check:manifest": "node scripts/check-manifest.mjs",
    "screenshots": "npm run build:e2e && playwright test -c playwright.screenshots.config.ts",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "wxt": "^0.21.5"
  },
  "private": true,
  "type": "module",
  "license": "MIT"
}
